[GENERAL]
#verbose = true
polynomialOrder = 6
#startFrom = "restart.fld"+time=0
startFrom = "base.fld"
stopAt = endTime
endTime = 400

dt = targetCFL=0.5 + max=2e-2 + initial=5e-3
timeStepper = tombo2

writeControl = simulationTime 
writeInterval = 10

#regularization = hpfrt + nModes=1 + scalingCoeff=5
constFlowRate = meanVelocity=1.0 + direction=X

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
boundaryTypeMap = wall
viscosity = 1/19000
density = 1.0
residualTol = 1e-06

[CASEDATA]
ReTau = 950
xLength = 6.283185307 
zLength = 3.141592653 
betaY = 2.2
tWallAvg = 10.0
number_elements_x = 36
number_elements_y = 16
number_elements_z = 18
tAvgWriteInterval=5000
stretchedY = 1

[TEMPERATURE]
boundaryTypeMap = none
solver = none

[SGSMODEL]
model = vreman
vreman_cs = 0.1

# Witness training data, same layout as SOD2D (src/plugins/wallModelML.hpp)
[WALLMODEL]
wm_mode = train
wm_boundary_ids = 1
wm_witness_dist = 0.1
wm_num_offwall_points = 1
wm_sample_field = instantaneous
period_walave = 1.0
wm_project_normal = false
wm_leapwitsave = 10
