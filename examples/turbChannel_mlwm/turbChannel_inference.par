[GENERAL]
#verbose = true
polynomialOrder = 6
#startFrom = "restart.fld"+UP+time=0
stopAt = endTime
endTime = 1000

dt = targetCFL=0.5 + max=2e-2 + initial=5e-3
timeStepper = tombo2

writeControl = simulationTime 
writeInterval = 200

#regularization = hpfrt + nModes=1 + scalingCoeff=5
#constFlowRate = meanVelocity=1.0 + direction=X

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
boundaryTypeMap = shl
viscosity = 1/19000
density = 1.0
residualTol = 1e-06

[CASEDATA]
ReTau = 950
xLength = 6.283185307 
zLength = 3.141592653 
betaY = 2.2
number_elements_x = 16
number_elements_y = 16
number_elements_z = 16
tAvgWriteInterval=20000
stretchedY = 0

[TEMPERATURE]
boundaryTypeMap = none
solver = none

[SGSMODEL]
model = vreman
vreman_cs = 0.1

# wm_inference_backend = reichardt runs the BC path without the database
[WALLMODEL]
wm_mode = infer
wm_boundary_ids = 1
wm_witness_dist = 0.1
wm_num_offwall_points = 1
wm_sample_field = instantaneous
period_walave = 1.0
wm_project_normal = false
wm_infer_stride = 1
wm_inference_backend = smartredis
