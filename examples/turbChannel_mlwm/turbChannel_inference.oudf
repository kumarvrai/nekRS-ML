// Boundary conditions
// =============================================================================
void velocityNeumannConditions(bcData *bc)
{
  const dfloat uTau = bc->usrwrk[bc->idM + 0 * bc->fieldOffset];
  const dfloat uvel = bc->usrwrk[bc->idM + 1 * bc->fieldOffset];
  const dfloat vvel = bc->usrwrk[bc->idM + 2 * bc->fieldOffset];
  const dfloat wvel = bc->usrwrk[bc->idM + 3 * bc->fieldOffset];

  const dfloat ut1 = uvel * bc->t1x + vvel * bc->t1y + wvel * bc->t1z;
  const dfloat ut2 = uvel * bc->t2x + vvel * bc->t2y + wvel * bc->t2z;

  const dfloat magUt = (sqrt(ut1*ut1 + ut2*ut2) + 1e-12);

  if (bc->x == 0 && bc->y == -1 && bc->z == 0){ 
     printf(" CHK BC: %f %f %f %f\n",uvel,vvel,wvel,uTau);
  }   

  if (magUt < 1e-8) {
    bc->tr1 = 0.0;
    bc->tr2 = 0.0;
    return;
  }

  bc->tr1 = -uTau * uTau * ut1 / magUt;
  bc->tr2 = -uTau * uTau * ut2 / magUt;

  //if (bc->x == 0 && bc->y == -1 && bc->z == 0){ 
  //   printf(" CHK BC: %f %f %f %f %f %f\n",uvel,vvel,wvel,uTau,bc->tr1,bc->tr2);
  //}   

  //if (bc->x == 0 && bc->y == -1 && bc->z == 0) printf(" SHL BC: %f %f\n",bc->tr1, bc->tr2);
}

// computes:
// Amat:  du1/dx1, du1/dx2, du1/dx3
//        du2/dx1, du2/dx2, du2/dx3
//        du3/dx1, du3/dx2, du3/dx3
// Cmat:  du1/dr1, du1/dr2, du1/dr3
//        du2/dr1, du2/dr2, du2/dr3
//        du3/dr1, du3/dr2, du3/dr3

@kernel void vreman(const dlong Nelements,
                                    @restrict const dfloat*  vgeo,
                                    @restrict const dfloat*  D,
                                    const dlong offset,
                                    @restrict const dfloat*  U,
                                    @restrict dfloat*  visco,
                                    @restrict dfloat*  model_stress)
{
  for(dlong e = 0; e < Nelements; e++; @outer(0)) { // for all elements
    @shared dfloat s_U[p_Nq][p_Nq];
    @exclusive dfloat s_Uloc[p_Nq];

    @shared dfloat s_V[p_Nq][p_Nq];
    @exclusive dfloat s_Vloc[p_Nq];

    @shared dfloat s_W[p_Nq][p_Nq];
    @exclusive dfloat s_Wloc[p_Nq];

    @shared dfloat s_D[p_Nq][p_Nq];

#ifdef smXX
    #pragma unroll p_Nq
#endif
    for(int k = 0; k < p_Nq; ++k){
      for(int j = 0; j < p_Nq; ++j; @inner(1)){
        for(int i = 0; i < p_Nq; ++i; @inner(0)) {
          const dlong id = e * p_Np + k * p_Nq * p_Nq + j * p_Nq + i;

          s_U[j][i]  = U[id + 0 * offset];
          s_V[j][i]  = U[id + 1 * offset];
          s_W[j][i]  = U[id + 2 * offset];

          if (k == 0)
            s_D[j][i] = D[j * p_Nq + i];
          if(k == 0){
            #pragma unroll p_Nq
            for(int l = 0 ; l < p_Nq; ++l){
              const dlong other_id = e * p_Np + l * p_Nq * p_Nq + j * p_Nq + i;
              s_Uloc[l] = U[other_id + 0 * offset];
              s_Vloc[l] = U[other_id + 1 * offset];
              s_Wloc[l] = U[other_id + 2 * offset];
            }
          }
        }
      }


    // Make sure all node data is loaded into @shared
    @barrier();
      for(int j = 0; j < p_Nq; ++j; @inner(1)) {
        for(int i = 0; i < p_Nq; ++i; @inner(0)) {
          const dlong gid = e * p_Np * p_Nvgeo + k * p_Nq * p_Nq + j * p_Nq + i;
          const dfloat drdx = vgeo[gid + p_RXID * p_Np];
          const dfloat drdy = vgeo[gid + p_RYID * p_Np];
          const dfloat drdz = vgeo[gid + p_RZID * p_Np];
          const dfloat dsdx = vgeo[gid + p_SXID * p_Np];
          const dfloat dsdy = vgeo[gid + p_SYID * p_Np];
          const dfloat dsdz = vgeo[gid + p_SZID * p_Np];
          const dfloat dtdx = vgeo[gid + p_TXID * p_Np];
          const dfloat dtdy = vgeo[gid + p_TYID * p_Np];
          const dfloat dtdz = vgeo[gid + p_TZID * p_Np];
          const dfloat JW   = vgeo[gid + p_JWID * p_Np];

          dfloat dUdr  = 0.f, dUds  = 0.f, dUdt  = 0.f;
          dfloat dVdr  = 0.f, dVds  = 0.f, dVdt  = 0.f;
          dfloat dWdr  = 0.f, dWds  = 0.f, dWdt  = 0.f;

#pragma unroll p_Nq
          for(int n = 0; n < p_Nq; ++n) {
            const dfloat Dr = s_D[i][n];
            const dfloat Ds = s_D[j][n];
            const dfloat Dt = s_D[k][n];

            dUdr += Dr * s_U[j][n];
            dUds += Ds * s_U[n][i];
            dUdt += Dt * s_Uloc[n];

            dVdr += Dr * s_V[j][n];
            dVds += Ds * s_V[n][i];
            dVdt += Dt * s_Vloc[n];

            dWdr += Dr * s_W[j][n];
            dWds += Ds * s_W[n][i];
            dWdt += Dt * s_Wloc[n];
          }

          const dlong id = e * p_Np + k * p_Nq * p_Nq + j * p_Nq + i;
          const dfloat multiplier = 1.0;

          dfloat poly = p_Nq - 1.0;
          //dfloat cs = 0.18108366;
          dfloat cs = 0.1;
          //dfloat cs = 0.0;
          dfloat dd = (2.0/poly)*(2.0/poly);
          dfloat c = 2.5*cs*cs;

          dfloat a11 = multiplier * (drdx * dUdr + dsdx * dUds + dtdx * dUdt);
          dfloat a21 = multiplier * (drdy * dUdr + dsdy * dUds + dtdy * dUdt);
          dfloat a31 = multiplier * (drdz * dUdr + dsdz * dUds + dtdz * dUdt);
          dfloat a12 = multiplier * (drdx * dVdr + dsdx * dVds + dtdx * dVdt);
          dfloat a22 = multiplier * (drdy * dVdr + dsdy * dVds + dtdy * dVdt);
          dfloat a32 = multiplier * (drdz * dVdr + dsdz * dVds + dtdz * dVdt);
          dfloat a13 = multiplier * (drdx * dWdr + dsdx * dWds + dtdx * dWdt);
          dfloat a23 = multiplier * (drdy * dWdr + dsdy * dWds + dtdy * dWdt);
          dfloat a33 = multiplier * (drdz * dWdr + dsdz * dWds + dtdz * dWdt);

          dfloat c11 = dUdr;
          dfloat c21 = dUds;
          dfloat c31 = dUdt;
          dfloat c12 = dVdr;
          dfloat c22 = dVds;
          dfloat c32 = dVdt;
          dfloat c13 = dWdr;
          dfloat c23 = dWds;
          dfloat c33 = dWdt;          

          dfloat asum = a11*a11 + a12*a12 + a13*a13 + a21*a21 + a22*a22 + a23*a23 + a31*a31 + a32*a32 + a33*a33;

          dfloat b11 = dd*(c11*c11 + c21*c21 + c31*c31);
          dfloat b22 = dd*(c12*c12 + c22*c22 + c32*c32);
          dfloat b33 = dd*(c13*c13 + c23*c23 + c33*c33);
          dfloat b12 = dd*(c11*c12 + c21*c22 + c31*c32);
          dfloat b13 = dd*(c11*c13 + c21*c23 + c31*c33);
          dfloat b23 = dd*(c12*c13 + c22*c23 + c32*c33);

          dfloat Bb= b11*b22-b12*b12+b11*b33-b13*b13+b22*b33-b23*b23;

          if(Bb>0 && asum>0 ) visco[id] = c*sqrt(Bb/asum);

          model_stress[id + 0 * offset]  = visco[id];    //(nu_t)
          //model_stress[id + 1 * offset]  = visco[id]*(a11+a11);
          //model_stress[id + 2 * offset]  = visco[id]*(a22+a22);
          //model_stress[id + 3 * offset]  = visco[id]*(a33+a33);
          //model_stress[id + 4 * offset]  = visco[id]*(a21+a12);
          //model_stress[id + 5 * offset]  = visco[id]*(a13+a31);
          //model_stress[id + 6 * offset]  = visco[id]*(a23+a32);
          //model_stress[id + 7 * offset]  = 0.5*(a11+a11);
          //model_stress[id + 8 * offset]  = 0.5*(a22+a22);
          //model_stress[id + 9 * offset]  = 0.5*(a33+a33);
          //model_stress[id + 10 * offset] = 0.5*(a21+a12);
          //model_stress[id + 11 * offset] = 0.5*(a13+a31);
          //model_stress[id + 12 * offset] = 0.5*(a23+a32);
          //model_stress[id + 13 * offset] = 0.5*(a21-a12);
          //model_stress[id + 14 * offset] = 0.5*(a31-a13);
          //model_stress[id + 15 * offset] = 0.5*(a32-a23);
        }
      }
      @barrier();
    } // k-loop
  }
}


@kernel void userVp(const dlong Nelements,
                    const dlong uOffset,
                    const dfloat visc,
                    @restrict const dfloat * visco,
                    @restrict dfloat * UPROP)
{
  for(dlong e=0;e<Nelements;++e;@outer(0)){
    for(int n=0;n<p_Np;++n;@inner(0)){
      const int id = e*p_Np + n;

//      UPROP[id + 0*uOffset] = 1.0 * visc;
      UPROP[id + 0*uOffset] = 1.0 * visc + visco[id];
      UPROP[id + 1*uOffset] = 1.0;

    }
  }
}

